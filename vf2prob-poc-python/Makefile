# VF2-Prob, Jan Hladěna, FIM UHK

PYTHON    ?= .venv/bin/python3
RUNNER    ?= run_experiments.py

OUTDIR    ?= ../results
DATADIR   ?= ../data
QDIR      ?= ../queries
SEED      ?= 324
RUNS      ?= 1

METHODS   ?= vf2,vf2pp,vf2pp-first,vf2bin,vf2prob
BIN_TAU   ?= 0.7
PROB_SAMPLE_EVERY ?= 300
PROB_UB      ?= node
PROB_SEARCH  ?= dfs

# Per-query time limits match the published PoC protocol (experiments.tex,
# subsec:protocol): 12 s for synthetic and molecular graphs, 10 s for gMark,
# a single run per query. Override for longer limits on a faster machine, e.g.
#   make synth_all TO_SYNTH=60 RUNS=3
TO_SYNTH  ?= 12
TO_MOL    ?= 12
TO_GMARK  ?= 10

ECHO = @printf

.PHONY: build help all \
        synth_all synth_S synth_M synth_L synth_S_fast synth_M_fast synth_L_fast \
        real_all mol_S mol_M mol_L gmark_S gmark_M gmark_L \
        clean_results \
        synth_all_assign synth_all_astar synth_all_astar_assign \
        real_all_assign real_all_astar real_all_astar_assign

build:
	python3 -m venv .venv
	.venv/bin/pip install -q -r requirements.txt

all: synth_all real_all

help:
	$(ECHO) "Targets:\n"
	$(ECHO) "  build             : create .venv and install dependencies\n"
	$(ECHO) "  all               : synth_all + real_all\n"
	$(ECHO) "  synth_all         : synthetic S/M/L\n"
	$(ECHO) "  real_all          : mol_(S/M/L) + gmark_(S/M/L)\n"
	$(ECHO) "  *_fast            : quick smoke-tests for synthetic\n"
	$(ECHO) "  clean_results     : remove CSVs in $(OUTDIR)\n"
	$(ECHO) "  -- PROB_UB=node|assign, PROB_SEARCH=dfs|astar, SEED=N\n"
	$(ECHO) "  NOTE: mol/gmark data must be pre-generated with 'make fetch-data'\n"


# =========================
# Synthetic (Erdos-Renyi, inline)
# =========================
synth_all: synth_S synth_M synth_L synth_all_assign synth_all_astar synth_all_astar_assign

synth_S:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --dataset synth --methods $(METHODS) \
	  --runs $(RUNS) --timeout $(TO_SYNTH) --qmin 5 --qmax 8 --nqueries 16 \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 0.80 --flip 0.00 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_synth_S.csv

synth_M:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --dataset synth --methods $(METHODS) \
	  --runs $(RUNS) --timeout $(TO_SYNTH) --qmin 9 --qmax 12 --nqueries 16 \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 0.70 --flip 0.05 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_synth_M.csv

synth_L:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --dataset synth --methods $(METHODS) \
	  --runs $(RUNS) --timeout $(TO_SYNTH) --qmin 13 --qmax 20 --nqueries 12 \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 0.60 --flip 0.10 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_synth_L.csv

synth_S_fast:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --dataset synth --methods $(METHODS) \
	  --runs 1 --timeout 20 --qmin 5 --qmax 8 --nqueries 4 \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 0.80 --flip 0.00 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_synth_S_fast.csv

synth_M_fast:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --dataset synth --methods $(METHODS) \
	  --runs 1 --timeout 30 --qmin 9 --qmax 12 --nqueries 4 \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 0.70 --flip 0.05 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_synth_M_fast.csv

synth_L_fast:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --dataset synth --methods $(METHODS) \
	  --runs 1 --timeout 40 --qmin 13 --qmax 20 --nqueries 4 \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 0.60 --flip 0.10 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_synth_L_fast.csv


# =========================
# MOL + gMark (data pre-generated by scripts/fetch_data.py)
# =========================
real_all: mol_S mol_M mol_L gmark_S gmark_M gmark_L real_all_assign real_all_astar real_all_astar_assign

mol_S:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --methods $(METHODS) --runs $(RUNS) --timeout $(TO_MOL) \
	  --data-path $(DATADIR)/mol/mol.graphml \
	  --queries-path $(QDIR)/mol/mol_S.json \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 1.0 --flip 0.0 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_mol_S.csv

mol_M:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --methods $(METHODS) --runs $(RUNS) --timeout $(TO_MOL) \
	  --data-path $(DATADIR)/mol/mol.graphml \
	  --queries-path $(QDIR)/mol/mol_M.json \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 1.0 --flip 0.0 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_mol_M.csv

mol_L:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --methods $(METHODS) --runs $(RUNS) --timeout $(TO_MOL) \
	  --data-path $(DATADIR)/mol/mol.graphml \
	  --queries-path $(QDIR)/mol/mol_L.json \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 1.0 --flip 0.0 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_mol_L.csv

gmark_S:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --methods $(METHODS) --runs $(RUNS) --timeout $(TO_GMARK) \
	  --data-path $(DATADIR)/gmark/gmark.graphml \
	  --queries-path $(QDIR)/gmark/gmark_S.json \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 1.0 --flip 0.0 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_gmark_S.csv

gmark_M:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --methods $(METHODS) --runs $(RUNS) --timeout $(TO_GMARK) \
	  --data-path $(DATADIR)/gmark/gmark.graphml \
	  --queries-path $(QDIR)/gmark/gmark_M.json \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 1.0 --flip 0.0 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_gmark_M.csv

gmark_L:
	@mkdir -p $(OUTDIR)
	$(PYTHON) $(RUNNER) \
	  --methods $(METHODS) --runs $(RUNS) --timeout $(TO_GMARK) \
	  --data-path $(DATADIR)/gmark/gmark.graphml \
	  --queries-path $(QDIR)/gmark/gmark_L.json \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) \
	  --pmin 1.0 --flip 0.0 \
	  --vf2prob-two-pass --vf2prob-sample-every $(PROB_SAMPLE_EVERY) \
	  --vf2prob-ub $(PROB_UB) --vf2prob-search $(PROB_SEARCH) \
	  --out $(OUTDIR)/results_gmark_L.csv


# =========================
# Housekeeping
# =========================
clean_results:
	rm -f $(OUTDIR)/results_*.csv


# =========================
# VF2-Prob variant sweeps
# =========================
synth_all_assign:
	$(MAKE) synth_S PROB_UB=assign; \
	$(MAKE) synth_M PROB_UB=assign; \
	$(MAKE) synth_L PROB_UB=assign

synth_all_astar:
	$(MAKE) synth_S PROB_SEARCH=astar; \
	$(MAKE) synth_M PROB_SEARCH=astar; \
	$(MAKE) synth_L PROB_SEARCH=astar

synth_all_astar_assign:
	$(MAKE) synth_S PROB_SEARCH=astar PROB_UB=assign; \
	$(MAKE) synth_M PROB_SEARCH=astar PROB_UB=assign; \
	$(MAKE) synth_L PROB_SEARCH=astar PROB_UB=assign

real_all_assign:
	$(MAKE) mol_S PROB_UB=assign; \
	$(MAKE) mol_M PROB_UB=assign; \
	$(MAKE) mol_L PROB_UB=assign; \
	$(MAKE) gmark_S PROB_UB=assign; \
	$(MAKE) gmark_M PROB_UB=assign; \
	$(MAKE) gmark_L PROB_UB=assign

real_all_astar:
	$(MAKE) mol_S PROB_SEARCH=astar; \
	$(MAKE) mol_M PROB_SEARCH=astar; \
	$(MAKE) mol_L PROB_SEARCH=astar; \
	$(MAKE) gmark_S PROB_SEARCH=astar; \
	$(MAKE) gmark_M PROB_SEARCH=astar; \
	$(MAKE) gmark_L PROB_SEARCH=astar

real_all_astar_assign:
	$(MAKE) mol_S PROB_SEARCH=astar PROB_UB=assign; \
	$(MAKE) mol_M PROB_SEARCH=astar PROB_UB=assign; \
	$(MAKE) mol_L PROB_SEARCH=astar PROB_UB=assign; \
	$(MAKE) gmark_S PROB_SEARCH=astar PROB_UB=assign; \
	$(MAKE) gmark_M PROB_SEARCH=astar PROB_UB=assign; \
	$(MAKE) gmark_L PROB_SEARCH=astar PROB_UB=assign
