# VF2-Prob, Jan Hladěna, FIM UHK

BUILD   ?= build
RUN     := ./$(BUILD)/vf2prob_run
AGG     := ./$(BUILD)/aggregate

OUTDIR  ?= ../results
DATADIR ?= ../data
QDIR    ?= ../queries
SEED    ?= 324
RUNS    ?= 3

METHODS      ?= vf2,vf2pp,vf2bin,mpm,vf2prob,vf2prob-assign,vf2prob-astar,vf2prob-astar-assign
SNAP_METHODS ?= vf2pp,mpm,vf2prob-assign,vf2prob-astar-assign
BIN_TAU      ?= 0.7

# Query counts per size (S/M use NQ, L uses NQ_L).
NQ   ?= 32
NQ_L ?= 30

# State budget B=2e5: the completion criterion (timeout is only a safety net).
MAXSTATES ?= 200000

TO_S ?= 60
TO_M ?= 90
TO_L ?= 120

ECHO = @printf

.PHONY: build test help \
        bench-synth bench-synth-S bench-synth-M bench-synth-L \
        bench-snap \
        bench-snap-facebook-S bench-snap-facebook-M bench-snap-facebook-L \
        bench-snap-enron-S bench-snap-enron-M bench-snap-enron-L \
        bench-snap-hepth-S bench-snap-hepth-M bench-snap-hepth-L \
        bench-all aggregate clean

build:
	cmake -S . -B $(BUILD) -DCMAKE_BUILD_TYPE=Release
	cmake --build $(BUILD) -j$$(nproc 2>/dev/null || sysctl -n hw.logicalcpu)

test:
	ctest --test-dir $(BUILD) --output-on-failure

help:
	$(ECHO) "Targets:\n"
	$(ECHO) "  build             : cmake configure + compile\n"
	$(ECHO) "  test              : run unit tests via ctest\n"
	$(ECHO) "  bench-synth       : synthetic S/M/L (inline generation)\n"
	$(ECHO) "  bench-snap        : SNAP facebook/enron/hepth (requires fetch-data)\n"
	$(ECHO) "  bench-all         : bench-synth + bench-snap\n"
	$(ECHO) "  aggregate         : aggregate per-query CSVs in $(OUTDIR)\n"
	$(ECHO) "  -- SEED=N, RUNS=N, METHODS=csv override supported\n"


# =========================
# Synthetic (Erdos-Renyi, inline generation)
# =========================
bench-synth: bench-synth-S bench-synth-M bench-synth-L

bench-synth-S:
	@mkdir -p $(OUTDIR)
	$(RUN) --dataset synth --methods $(METHODS) \
	  --runs $(RUNS) --timeout $(TO_S) --qmin 5 --qmax 8 --nqueries $(NQ) \
	  --seed $(SEED) --pmin 0.80 --flip 0.00 --bin-threshold $(BIN_TAU) --max-states $(MAXSTATES) \
	  --out $(OUTDIR)/cpp_synth_S.csv

bench-synth-M:
	@mkdir -p $(OUTDIR)
	$(RUN) --dataset synth --methods $(METHODS) \
	  --runs $(RUNS) --timeout $(TO_M) --qmin 9 --qmax 12 --nqueries $(NQ) \
	  --seed $(SEED) --pmin 0.70 --flip 0.05 --bin-threshold $(BIN_TAU) --max-states $(MAXSTATES) \
	  --out $(OUTDIR)/cpp_synth_M.csv

bench-synth-L:
	@mkdir -p $(OUTDIR)
	$(RUN) --dataset synth --methods $(METHODS) \
	  --runs $(RUNS) --timeout $(TO_L) --qmin 13 --qmax 20 --nqueries $(NQ_L) \
	  --seed $(SEED) --pmin 0.60 --flip 0.10 --bin-threshold $(BIN_TAU) --max-states $(MAXSTATES) \
	  --out $(OUTDIR)/cpp_synth_L.csv


# =========================
# SNAP datasets (data pre-generated by scripts/fetch_data.py)
# =========================
bench-snap: bench-snap-facebook-S bench-snap-facebook-M bench-snap-facebook-L \
            bench-snap-enron-S    bench-snap-enron-M    bench-snap-enron-L \
            bench-snap-hepth-S    bench-snap-hepth-M    bench-snap-hepth-L

# STRING PPI scalability: same per-query format as SNAP; feeds the tab:snap block.
bench-string: bench-string-S bench-string-M bench-string-L

bench-string-S:
	@mkdir -p $(OUTDIR)
	$(RUN) --dataset graphml \
	  --data-path $(DATADIR)/string/scerevisiae.graphml \
	  --queries-path $(QDIR)/string/string_S.json \
	  --methods $(SNAP_METHODS) --runs $(RUNS) --timeout $(TO_S) \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) --max-states $(MAXSTATES) \
	  --out $(OUTDIR)/cpp_string_S.csv

bench-string-M:
	@mkdir -p $(OUTDIR)
	$(RUN) --dataset graphml \
	  --data-path $(DATADIR)/string/scerevisiae.graphml \
	  --queries-path $(QDIR)/string/string_M.json \
	  --methods $(SNAP_METHODS) --runs $(RUNS) --timeout $(TO_M) \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) --max-states $(MAXSTATES) \
	  --out $(OUTDIR)/cpp_string_M.csv

bench-string-L:
	@mkdir -p $(OUTDIR)
	$(RUN) --dataset graphml \
	  --data-path $(DATADIR)/string/scerevisiae.graphml \
	  --queries-path $(QDIR)/string/string_L.json \
	  --methods $(SNAP_METHODS) --runs $(RUNS) --timeout $(TO_L) \
	  --seed $(SEED) --bin-threshold $(BIN_TAU) --max-states $(MAXSTATES) \
	  --out $(OUTDIR)/cpp_string_L.csv

